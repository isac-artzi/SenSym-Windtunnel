FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Freestream turbulence: Tu = @@TU_PERCENT@@ %  (PRD SIM-5)
dimensions      [0 2 -2 0 0 0 0];

internalField   uniform @@K_INF@@;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    farfield
    {
        type            freestream;
        freestreamValue uniform @@K_INF@@;
        value           uniform @@K_INF@@;
    }

    // Wall-resolved (y+ < 1): k = 0 at the wall (tiny positive value for robustness).
    airfoil
    {
        type            fixedValue;
        value           uniform 1e-12;
    }
}

