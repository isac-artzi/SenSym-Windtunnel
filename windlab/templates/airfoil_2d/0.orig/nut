FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform @@NUT_INF@@;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    farfield
    {
        type            calculated;
        value           uniform @@NUT_INF@@;
    }

    // Wall-resolved: nut = 0 at the wall.
    airfoil
    {
        type            nutLowReWallFunction;
        value           uniform 0;
    }
}

