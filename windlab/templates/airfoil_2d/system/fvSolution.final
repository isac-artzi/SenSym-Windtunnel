/*--------------------------------*- C++ -*----------------------------------*\
| WindLab airfoil_2d template                                                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// FINAL settings, copied over fvSolution by WindLab's runner after the start-up iterations.

solvers
{
    p
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        nCellsInCoarsestLevel 50;
        tolerance       1e-9;
        relTol          0.01;
    }

    Phi
    {
        $p;
        relTol          0.01;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.05;
        nSweeps         1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;
}

potentialFlow
{
    nNonOrthogonalCorrectors 3;
}

relaxationFactors
{
    equations
    {
        U               0.9;
        k               0.7;
        omega           0.7;
    }
}

cache
{
    grad(U);
}

// ************************************************************************* //
