/*--------------------------------*- C++ -*----------------------------------*\
| WindLab airfoil_2d template                                                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       latestTime;
startTime       0;

// WindLab's run monitor switches this to writeNow once CL and CD have settled.
stopAt          endTime;
endTime         @@MAX_ITERATIONS@@;
deltaT          1;

writeControl    timeStep;
writeInterval   @@MAX_ITERATIONS@@;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;

runTimeModifiable true;

functions
{
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        log             yes;

        patches         (airfoil);
        rho             rhoInf;
        rhoInf          @@RHO@@;

        // Rotated with the freestream so CL is normal to the flow, CD along it.
        dragDir         (@@DRAG_DIR@@);
        liftDir         (@@LIFT_DIR@@);
        pitchAxis       (0 1 0);
        CofR            (@@COFR@@);
        magUInf         @@U_MAG@@;
        lRef            @@L_REF@@;
        Aref            @@A_REF@@;
    }

    // Pressure and viscous parts of the force, in N (windlab.results.force_split).
    forces1
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        log             no;

        patches         (airfoil);
        rho             rhoInf;
        rhoInf          @@RHO@@;
        CofR            (@@COFR@@);
    }

    yPlus1
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    solverInfo1
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p k omega);
        writeResidualFields no;
        writeControl    timeStep;
        writeInterval   1;
    }
}

// ************************************************************************* //
