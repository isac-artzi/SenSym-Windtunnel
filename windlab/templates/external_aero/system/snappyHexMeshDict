FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Refinement levels are fixed per template; presets only scale the background
// cell size, so Quick/Standard/Detailed form a consistent refinement family (SIM-4).

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    body.stl
    {
        type triSurfaceMesh;
        name body;
    }
    nearBox
    {
        type box;
        min  (@@NEAR_MIN@@);
        max  (@@NEAR_MAX@@);
    }
    wakeBox
    {
        type box;
        min  (@@WAKE_MIN@@);
        max  (@@WAKE_MAX@@);
    }
    farWakeBox
    {
        type box;
        min  (@@FARWAKE_MIN@@);
        max  (@@FARWAKE_MAX@@);
    }
    // the thin parts of an upload (fins, plates), for the refinement band below; empty otherwise
    @@THIN_GEOMETRY@@
}

castellatedMeshControls
{
    maxLocalCells       @@MAX_LOCAL_CELLS@@;
    maxGlobalCells      @@MAX_GLOBAL_CELLS@@;
    minRefinementCells  10;
    // Rebalance between refinement passes only above 30 % imbalance (was 10 %): fewer
    // redistributions, same final mesh (the last balance brings it under 1 %); task 010.
    maxLoadUnbalance    0.30;
    nCellsBetweenLevels 3;

    features
    (
        {
            file  "body.eMesh";
            level @@FEATURE_LEVEL@@;
        }
    );

    refinementSurfaces
    {
        body
        {
            level (@@SURFACE_LEVEL_MIN@@ @@SURFACE_LEVEL_MAX@@);
            patchInfo
            {
                type        wall;
                inGroups    (bodyGroup);
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        nearBox     { mode inside; levels ((1e15 @@NEAR_LEVEL@@)); }
        wakeBox     { mode inside; levels ((1e15 @@WAKE_LEVEL@@)); }
        farWakeBox  { mode inside; levels ((1e15 @@FARWAKE_LEVEL@@)); }
        // Refinement band around thin plates and fins, only when the upload has them
        // (windlab.geometry.thin; empty otherwise): every cell within a couple of fine
        // cells of the thin triangles (thin.stl) is refined two levels above the surface.
        @@THIN_REFINEMENT@@
    }

    locationInMesh (@@LOCATION_IN_MESH@@);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          50;
    nRelaxIter          5;
    // 5 feature-snap passes (was 10): the same cells, layers and quality on the NACA wing
    // for a third less snapping time (validation/performance.md, task 010).
    nFeatureSnapIter    5;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;

    layers
    {
        "body.*"
        {
            nSurfaceLayers  @@N_LAYERS@@;
        }
    }

    expansionRatio      @@LAYER_EXPANSION@@;
    finalLayerThickness @@LAYER_FINAL_THICKNESS@@;
    minThickness        0.05;
    nGrow               0;
    featureAngle        130;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    #includeEtc "caseDicts/meshQualityDict"
    minFaceWeight   0.02;
    nSmoothScale    4;
    errorReduction  0.75;
}

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance 1e-6;

