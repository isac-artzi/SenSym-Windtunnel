FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       latestTime;
startTime       0;

// WindLab's run monitor switches this to writeNow once CL and CD have settled.
stopAt          endTime;
endTime         @@MAX_ITERATIONS@@;
deltaT          1;

writeControl    timeStep;
writeInterval   @@MAX_ITERATIONS@@;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;

runTimeModifiable true;

functions
{
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        log             yes;

        patches         (bodyGroup);
        rho             rhoInf;
        rhoInf          @@RHO@@;

        // Rotated with the freestream so CL is normal to the flow, CD along it.
        dragDir         (@@DRAG_DIR@@);
        liftDir         (@@LIFT_DIR@@);
        pitchAxis       (0 1 0);
        CofR            (@@COFR@@);
        magUInf         @@U_MAG@@;
        lRef            @@L_REF@@;
        Aref            @@A_REF@@;
    }

    // The same force split into its pressure and viscous (skin-friction) parts, in N;
    // WindLab projects them onto dragDir/liftDir (windlab.results.force_split).
    forces1
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        log             no;

        patches         (bodyGroup);
        rho             rhoInf;
        rhoInf          @@RHO@@;
        CofR            (@@COFR@@);
    }

    yPlus1
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    solverInfo1
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p k omega);
        writeResidualFields no;
        writeControl    timeStep;
        writeInterval   1;
    }

    wallShearStress1
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (bodyGroup);
        writeControl    writeTime;
    }

    // Flow picture for the results page: a slice through the middle of the part
    // (y = centre of its box), only near the part, speed and pressure at the points.
    midPlane
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   vtk;
        fields          (U p);
        interpolationScheme cellPoint;
        surfaces
        {
            plane
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict
                {
                    point   (@@SLICE_POINT@@);
                    normal  (0 1 0);
                }
                bounds      (@@SLICE_MIN@@) (@@SLICE_MAX@@);
                interpolate true;
            }
        }
    }

    bodySurface
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   vtk;
        fields          (p wallShearStress);
        interpolationScheme cellPoint;
        surfaces
        {
            body
            {
                type        patch;
                patches     ("body.*");
                interpolate false;
            }
        }
    }
}

