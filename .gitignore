# macOS / editors
.DS_Store
.vscode/*
!.vscode/extensions.json

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Node / front end
node_modules/
.pnpm-store/

# Static GitHub Pages demo (built by scripts/build_static_demo.py)
site/

# OpenFOAM run output (simulation results never go in git)
runs/
processor*/
postProcessing/
[0-9]*.[0-9]*/
!**/templates/**
log.*
*.foam
constant/polyMesh/
constant/extendedFeatureEdgeMesh/
constant/triSurface/*.eMesh

# Large geometry outside the curated test set
*.stl
!tests/geometry/**/*.stl
*.step
*.stp
!tests/geometry/**/*.step
!validation/robustness/parts/*.step

# windlab benchmark output (written to the current folder)
windlab-benchmark-*.json
windlab-benchmark-*.txt

# Local secrets
.env
*.token

# Agent run logs
.agent/logs/

# Private: design docs, agent tasks, internal notes, maintainer tooling (never public)
.agent/
CLAUDE.md
*.docx
*PRD*
docs/MONDAY_DEMO.md
dev/agent
dev/wl
scripts/__pycache__/
